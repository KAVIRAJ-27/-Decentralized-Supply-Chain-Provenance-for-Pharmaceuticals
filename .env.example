# ==============================================================================
# MediTrace — Environment Configuration Template
# NOTE: Do NOT commit actual secrets or production private keys to version control.
# Copy this file to .env in each corresponding workspace or root as needed.
# ==============================================================================

# --- Node & Environment ---
NODE_ENV=development
PORT=5000

# --- Blockchain Network (Hardhat Local / Sepolia / Polygon) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
MEDITRACE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Deployment Private Key (Local test key only — never put production keys here)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_SIGNER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- Backend API & Security ---
JWT_SECRET=meditrace_super_secret_jwt_key_phase1_2026
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Database Configuration ---
DATABASE_TYPE=sqlite
DATABASE_FILE=./data/meditrace.sqlite
# If using PostgreSQL in production:
# DATABASE_URL=postgresql://meditrace_user:password@localhost:5432/meditrace_db

# --- Frontend Application ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
VITE_MEDITRACE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Mobile Scanning App ---
VITE_MOBILE_API_URL=http://localhost:5000/api
